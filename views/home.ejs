<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
    <title>Homepage</title>
  </head>
  <body>
    <%- include('./partials/scripts.ejs') %> <%-
    include('./partials/navbar.ejs') %>

    <div class="container mt-3">
      <div class="row mb-3">
        <div class="col-md-8">
          <form class="d-flex" role="search" method="get" action="/">
            <input
              class="form-control me-2"
              type="search"
              placeholder="Search by title or content"
              aria-label="Search"
              name="q"
              value="<%= query %>"
            />
            <% if (selectedGenre) { %>
            <input type="hidden" name="genre" value="<%= selectedGenre %>" />
            <% } %>
            <button class="btn btn-outline-primary" type="submit">
              Search
            </button>
          </form>
        </div>
      </div>

      <div class="row">
        <div class="col-12 mb-3">
          <nav class="nav nav-pills overflow-auto genres-nav">
            <% const genres =
            ['Articles','Freestyles','Haikus','Poems','Prose','Short-stories'];
            %>
            <a class="nav-link <%= !selectedGenre ? 'active' : '' %>" href="/"
              >All</a
            >
            <% genres.forEach(g => { %>
            <a
              class="nav-link <%= selectedGenre===g ? 'active' : '' %>"
              href="/?genre=<%= encodeURIComponent(g) %>"
              ><%= g %></a
            >
            <% }) %>
          </nav>
        </div>
      </div>

      <div class="row row-cols-1 row-cols-md-3 g-4">
        <% blogs.forEach(blog => { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <img
              src="<%= blog.coverUrl %>"
              class="card-img-top home-card-img"
              alt="<%= blog.title %>"
            />
            <div class="card-body d-flex flex-column">
              <h5 class="card-title">
                <a
                  href="/blog/<%= blog._id %>"
                  class="stretched-link text-decoration-none"
                  ><%= blog.title %></a
                >
              </h5>
              <p class="text-muted mb-1 small d-flex align-items-center">
                <img
                  src="<%= blog.createdBy?.pfpUrl || '/images/default.png' %>"
                  width="28"
                  height="28"
                  class="rounded-circle me-2"
                  alt="author"
                />
                by <%= blog.createdBy ? blog.createdBy.username : 'Unknown' %>
              </p>
              <p class="card-text text-truncate">
                <%= blog.preview && blog.preview.length ? blog.preview :
                (blog.body || '').replace(/<[^>]+>/g, '').substring(0, 160) %>
              </p>
              <div class="mt-auto">
                <span class="badge bg-secondary"><%= blog.category %></span>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </body>
</html>
