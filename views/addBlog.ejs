<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <title>Add new blog</title>
  </head>
  <body>
    <%- include('./partials/scripts.ejs') %>
    <%- include('./partials/navbar.ejs') %>

    <div class="container mt-3">
      <form action="/blog" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="coverImg" class="form-label">Cover Image</label>
          <input
            type="file"
            class="form-control"
            id="coverImg"
            name="coverImg"
            aria-describedby="coverImg"
          />
        </div>
        <div class="mb-3">
          <label for="category" class="form-label">Blog type / Genre</label>
          <select id="category" name="category" class="form-select">
            <% const types = ['Articles','Freestyles','Haikus','Poems','Prose','Short-stories']; %>
            <% types.forEach(t => { %>
              <option value="<%= t %>" <%= (selectedType === t || (!selectedType && t==='Articles')) ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
        </div>
          <div class="mb-3">
            <label for="preview" class="form-label">Preview (one line)</label>
            <input id="preview" name="preview" class="form-control" maxlength="200" placeholder="Short preview shown on home page">
          </div>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            aria-describedby="title"
            placeholder="Add a title"
          />
        </div>
        <div class="mb-3">
          <label for="body" class="form-label">Body</label>
          <input type="hidden" id="hiddenBody" name="body" />
          <div id="editor" style="min-height: 300px; background: white; border-radius:6px;"></div>
        </div>
        <div class="mb-3">
          <button type="submit" class="btn btn-primary">Post</button>
        </div>
      </form>
    </div>
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
      const quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['link', 'image'],
            ['clean']
          ]
        }
      });
      const form = document.querySelector('form');
      form.addEventListener('submit', function(e){
        const html = quill.root.innerHTML;
        document.getElementById('hiddenBody').value = html;
      });
    </script>
  </body>
</html>
